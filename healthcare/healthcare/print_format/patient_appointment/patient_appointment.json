 "css": "\n        /*body {*/\n        /*    font-family: Arial, sans-serif;*/\n        /*    font-size: 14px;*/\n        /*    margin: 30px;*/\n        /*    color: #000;*/\n        /*}*/\n\n        .header {\n            text-align: center;\n        }\n\n        .header h2 {\n            margin: 0;\n        }\n\n        .header p {\n            margin: 0;\n        }\n\n        /*.arrow {*/\n        /*    position: absolute;*/\n        /*    right: 50px;*/\n        /*    top: 80px;*/\n        /*    width: 100px;*/\n        /*}*/\n\n        table {\n            width: 200%;\n            border-collapse: collapse;\n            margin-top: 15px;\n        }\n\n        th {\n            border: 1px solid black;\n            padding: 6px;\n            text-align: left;\n        }\n\n        .section-table td {\n            padding: 4px 6px;\n        }\n\n        .right-align {\n            text-align: right;\n        }\n\n        .terms {\n            font-size: 13px;\n            margin-top: 10px;\n        }\n\n        .terms ul {\n            margin: 5px 0 0 20px;\n            padding: 0;\n        }\n\n        .footer {\n            margin-top: 30px;\n            text-align: right;\n            font-weight: bold;\n        }\n\n        .in-words {\n            font-weight: bold;\n            margin-top: 5px;\n        }\n\n        hr {\n            margin-top: 15px;\n            margin-bottom: 15px;\n        }\n",
