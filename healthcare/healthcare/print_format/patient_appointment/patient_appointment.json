 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    \n</head>\n<body>\n\n    <!-- Arrow image -->\n    <!--<img src=\"https://i.ibb.co/SskL9Xy/arrow.png\" alt=\"Arrow\" class=\"arrow\" />-->\n\n    <!-- Header -->\n    <div class=\"header\">\n        {% set addressinfo= frappe.get_doc('Address',\"Ascra Healthcare-Billing\") %}\n        <h2>{{ doc.company }}</h2>\n        <p> {{ addressinfo.address_line1 }}</p>\n        <p> {{ addressinfo.address_line2 }}</p>\n        <p> {{ addressinfo.city }},{{ addressinfo.state }},{{ addressinfo.country }}-{{ addressinfo.pincode }}</p>\n        <h3>OPD BILL</h3>\n    </div>\n         <!-- Patient & Bill Details -->\n   <table style=\"width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px;\" border=\"1\">\n    <!-- Header Rows -->\n    {% set billinfo= frappe.get_doc('Sales Invoice', doc.ref_sales_invoice) %}\n   \n    {% set patientinfo= frappe.get_doc('Patient', doc.patient) %}\n    <tr>\n        <td style=\"border: 1px solid black; width: 30%;\" colspan=\"1\">\n            <strong>Bill Date:</strong> {{billinfo.get_formatted(\"posting_date\")}}\n        </td>\n        <td style=\"border: 1px solid black; width: 20%;\" colspan=\"1\">\n            <strong>Bill No.:</strong> {{doc.ref_sales_invoice}}\n        </td>\n        <td style=\"border: 1px solid black; width: 45%;\" colspan=\"3\">\n            <strong>Consulting Doctor:</strong> Dr. Manan Patel\n        </td>\n    </tr>\n     <tr>\n        <td style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\" colspan=\"1\">\n            <strong>Patient Name:</strong> \n        </td>\n        <td style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\" colspan=\"1\">\n            {{doc.patient_name}}\n        </td>\n        <td  style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\"colspan=\"3\">\n            <strong>Patient ID:</strong> {{patientinfo.name}}\n        </td>\n       \n    </tr>\n    <tr>\n        <td style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\" colspan=\"1\">\n            <strong>Age:</strong> {{doc.patient_age}}\n        </td>\n        <td style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\" colspan=\"1\">\n            <strong>Gender.:</strong> {{doc.patient_sex}}\n        </td>\n        <td style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\" colspan=\"2\">\n            <strong>Mo No:</strong> {{patientinfo.mobile}}\n        </td>\n    </tr>\n     <tr>\n        <td \n            style=\"width: 5%; text-align: left; border-top: none; border-bottom: none; border-left: none; border-right: none;\"colspan=\"3\"><strong>Address:</strong> Darbhanga, Bihar\n        </td>\n    </tr>\n\n\n     <tr>\n    <th style=\"width: 5%; text-align: left;\">Sr No</th>\n    <th style=\"width: 50%; text-align: left;\">OPD Services Details</th>\n    <th style=\"width: 15%; text-align: center;\">QTY</th>\n    <th style=\"width: 15%; text-align: right;\">Rate</th>\n    <th style=\"width: 15%; text-align: right;\">Amount</th>\n</tr>\n\n \n{%- for row in billinfo.items -%}\n<tr>\n    <td style=\"width: 5%; text-align: left; border-top: 1px solid black; border-bottom: none;\">{{ loop.index }}</td>\n    <td style=\"width: 50%; text-align: left; border-top: 1px solid black; border-bottom: none;\">{{ row.item_code }}</td>\n    <td style=\"width: 15%; text-align: center; border-top: 1px solid black; border-bottom: none;\">{{ row.qty }}</td>\n    <td style=\"width: 15%; text-align: right; border-top: 1px solid black; border-bottom: none;\">{{ row.rate }}</td>\n    <td style=\"width: 15%; text-align: right; border-top: 1px solid black; border-bottom: none;\">{{ row.amount }}</td>\n</tr>\n{%- endfor -%}\n\n\n\n\n    \n    <tr>\n        <td colspan=\"2\"><strong>{{ billinfo.in_words}}</strong></td>\n        <td colspan=\"2\" style=\"text-align: right;\"><strong>Total Amount</strong></td>\n        <td><strong>{{ billinfo.rounded_total}}</strong></td>\n    </tr>\n\n  \n  <tr>\n        <td style=\"border: 1px solid black;  border-left: none; border-right: none;\" colspan=\"2\">\n            <p ><strong>Terms & Conditions:</strong></p>\n            <ul style=\"margin-top: 0;\">\n                {{billinfo.terms}}\n            </ul>\n        </td>\n        <td colspan=\"3\" style=\"vertical-align: bottom; font-weight: bold; border-left: none; border-right: none; border-top: 1px solid black; border-bottom: 1px solid black; height: 60px;\">\n            For,<br>{{ doc.company }}\n        </td>\n\n\n    </tr>\n   \n</table>\n\n\n</table>\n</html>\n",
